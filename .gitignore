**/__pycache__/
**/*.egg-info/
**/.venv/
**/.pytest_cache/
**/data/
**/results/
**/cache/
**/models/
**/private_models/
**/private/
**/build/
**/dist/
**/paths.toml
**/cohort_bag_private.toml
**/*.local.toml
